{
	"name": "necord",
	"description": "A module for creating Discord bots using NestJS, based on Discord.js",
	"version": "7.0.0",
	"type": "module",
	"scripts": {
		"build": "rimraf dist && tsc -p tsconfig.build.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"prepublish:npm": "npm run build",
		"publish:npm": "release-it",
		"prepublish:dev": "npm run build",
		"publish:dev": "npm publish --access public --tag dev",
		"prepare": "husky",
		"postinstall": "opencollective",
		"format": "prettier --write \"{src,apps,libs,test}/**/*.ts\"",
		"lint": "oxlint --type-aware --deny-warnings src test",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:cov": "vitest run --coverage",
		"test:ci": "vitest run --coverage",
		"test:package": "npm run build && npm pack --dry-run && node --input-type=module --eval \"await import('necord')\" && node --eval \"require('necord')\""
	},
	"lint-staged": {
		"*.ts": [
			"npm run format",
			"npm run test:ci"
		]
	},
	"directories": {
		"lib": "src",
		"test": "test"
	},
	"funding": {
		"type": "opencollective",
		"url": "https://opencollective.com/necord"
	},
	"collective": {
		"type": "opencollective",
		"url": "https://opencollective.com/necord",
		"donation": {
			"text": "Become a financial contributor:"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"keywords": [
		"nest",
		"nestjs",
		"nestjs-module",
		"discord",
		"discordjs",
		"discord bot",
		"discord bot api",
		"bot",
		"bot api",
		"bot framework"
	],
	"license": "MIT",
	"homepage": "https://necord.org",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/necordjs/necord.git"
	},
	"bugs": {
		"url": "https://github.com/necordjs/necord/issues"
	},
	"author": "Alexey Filippov <socket.someone@gmail.com>",
	"contributors": [
		"Alexey Filippov <socket.someone@gmail.com>"
	],
	"dependencies": {
		"@nuxt/opencollective": "^0.4.1",
		"path-to-regexp": "8.4.2",
		"tslib": "^2.8.1"
	},
	"devDependencies": {
		"@commitlint/cli": "21.2.2",
		"@commitlint/config-angular": "21.2.2",
		"@nestjs/common": "12.0.1",
		"@nestjs/core": "12.0.1",
		"@nestjs/testing": "12.0.1",
		"@release-it/conventional-changelog": "^12.0.0",
		"@types/node": "26.4.0",
		"@vitest/coverage-v8": "4.1.11",
		"discord-api-types": "0.38.54",
		"discord.js": "14.27.0",
		"eslint": "^10.0.0",
		"eslint-plugin-perfectionist": "5.11.0",
		"eslint-plugin-prettier": "5.5.6",
		"husky": "9.1.7",
		"lint-staged": "17.4.1",
		"oxlint": "1.81.0",
		"oxlint-tsgolint": "7.0.2001",
		"prettier": "3.9.6",
		"reflect-metadata": "0.2.2",
		"release-it": "21.0.2",
		"rimraf": "6.1.3",
		"rxjs": "7.8.2",
		"ts-node": "10.9.2",
		"typescript": "7.0.2",
		"vitest": "4.1.11"
	},
	"peerDependencies": {
		"@nestjs/common": "^10.2.0 || ^11.0.0 || ^12.0.0",
		"@nestjs/core": "^10.2.0 || ^11.0.0 || ^12.0.0",
		"discord-api-types": "^0.37.99",
		"discord.js": "^14.0.1",
		"reflect-metadata": "^0.2.1",
		"rxjs": "^7.2.0"
	},
	"engines": {
		"node": "^20.19.0 || >=22.13.0",
		"npm": ">=8.6.0"
	}
}
